<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    tools:context=".views.fragments.HomeFragment"
    android:clickable="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/hf_app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bar_bg"
            android:paddingTop="22dp"
            android:paddingBottom="14dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/hf_search_view"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_view"
                android:hint="@string/search_jobs"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:queryHint="Search jobs..."
                app:submitBackground="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/hf_filter_btn"
                app:layout_constraintEnd_toStartOf="@id/hf_filter_btn"
                android:layout_marginEnd="12dp" />

            <ImageButton
                android:id="@+id/hf_filter_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_filter_btn"
                android:src="@drawable/icon_filter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/filter_badge_tv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_filter_badge"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone"
                android:translationX="4dp"
                android:translationY="-4dp"
                tools:text="2"
                tools:visibility="visible"
                app:layout_constraintEnd_toEndOf="@id/hf_filter_btn"
                app:layout_constraintTop_toTopOf="@id/hf_filter_btn" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/very_light_grey"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/no_api_db_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="104dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_for_no_saved_lay"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/no_saved_iv"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:src="@drawable/icon_warning" />

        <TextView
            android:id="@+id/no_saved_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/waiting_for_network"
            android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance.Dropdown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/no_saved_tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/it_s_empty_here_for_now_due_to_the_lack_of_network"
            android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
            android:textSize="15sp" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/no_search_res_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="104dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_for_no_saved_lay"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/no_search_iv"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:src="@drawable/icon_search_off" />

        <TextView
            android:id="@+id/no_search_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/there_are_no_results_for_your_search"
            android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance.Dropdown"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/no_result_tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/try_changing_filters_or_entering_a_different_word"
            android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
            android:textSize="15sp" />

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hf_recycler_view"
        android:layout_width="match_parent"
        android:paddingTop="10dp"
        android:clipToPadding="false"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>