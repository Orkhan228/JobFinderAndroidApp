<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".views.fragments.SettingsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_preferences_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/sp_tv_nu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferences"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/settings_reminders_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/sp_tv_nu"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@drawable/bg_root_set_item"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/sp_iv_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_notification_light_blue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_settings_item_icon"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/sp_tv_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/sp_iv_reminder"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/reminders"
                    android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                    android:textSize="16sp"
                    android:textColor="@color/main_text_color"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/sp_tb_reminder_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="No new reminders"
                    android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                    android:textSize="13sp"
                    android:textColor="@color/grey_bot_menu"
                    app:layout_constraintStart_toStartOf="@id/sp_tv_reminder"
                    app:layout_constraintBottom_toBottomOf="@id/sp_iv_reminder" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/baseline_arrow_forward_ios_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/light_grey_darker" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/settings_country_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/settings_reminders_lay"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@drawable/bg_root_set_item"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/sp_iv_country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_planet_green"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_settings_item_country"
                    android:padding="8dp"
                    app:tint="@color/purple" />

                <TextView
                    android:id="@+id/sp_tv_country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/sp_iv_country"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/country"
                    android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                    android:textSize="16sp"
                    android:textColor="@color/main_text_color"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/sp_tb_country_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Great Britain"
                    android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                    android:textSize="13sp"
                    android:textColor="@color/grey_bot_menu"
                    app:layout_constraintStart_toStartOf="@id/sp_tv_country"
                    app:layout_constraintBottom_toBottomOf="@id/sp_iv_country" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/baseline_arrow_forward_ios_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/light_grey_darker" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/settings_dark_mode_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/settings_country_lay"
                app:layout_constraintStart_toStartOf="parent"
                android:background="@drawable/bg_root_set_item"
                android:layout_marginTop="12dp"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/sp_iv_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_moon_turquoise"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_settings_item_dark_mode"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/sp_tv_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/sp_iv_dark_mode"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/dark_mode"
                    android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                    android:textSize="16sp"
                    android:textColor="@color/main_text_color"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/sp_tb_mode_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Disabled"
                    android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
                    android:textSize="13sp"
                    android:textColor="@color/grey_bot_menu"
                    app:layout_constraintStart_toStartOf="@id/sp_tv_dark_mode"
                    app:layout_constraintBottom_toBottomOf="@id/sp_iv_dark_mode" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sp_dark_mode_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:trackDecorationTint="@color/light_grey_blue_selector"
                    app:thumbTint="@color/app_bar_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>