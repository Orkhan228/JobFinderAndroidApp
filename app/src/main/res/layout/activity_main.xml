<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".views.activities.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ma_app_bar_layout"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_bar_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ma_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:titleTextColor="@color/main_text_color"
            app:contentInsetStart="16dp"
            app:itemBackground="?attr/selectableItemBackgroundBorderless"
            app:subtitle="Find your dream job"
            app:subtitleTextAppearance="@style/TextAppearance.AppCompat.MaToolbarSubTittle"
            app:title="JobSearch"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.MaToolbarTitle" />

    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/ma_app_bar_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/very_light_grey"
        app:layout_constraintTop_toBottomOf="@id/ma_app_bar_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/ma_network_problem_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ma_no_con_tv"
        android:gravity="center"
        android:text="@string/no_internet_connection"
        android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:translationZ="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ma_app_bar_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_cont_view"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/fragments_navigation"
        app:layout_constraintTop_toBottomOf="@id/ma_app_bar_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bot_nav_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_root_no_rad_ll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bot_nav_menu"
        app:itemBackground="@android:color/transparent"
        app:itemIconSize="25dp"
        app:itemIconTint="@color/bottom_nav_view_selector"
        app:itemTextColor="@color/bottom_nav_view_selector"
        app:horizontalItemTextAppearanceActive="@style/TextAppearance.AppCompat.JobItemTextAppearance"
        app:horizontalItemTextAppearanceInactive="@style/TextAppearance.AppCompat.JobItemTextAppearance"
        app:itemTextAppearanceActive="@style/TextAppearance.AppCompat.JobItemTextAppearance"
        app:itemTextAppearanceInactive="@style/TextAppearance.AppCompat.JobItemTextAppearance" />

</androidx.constraintlayout.widget.ConstraintLayout>