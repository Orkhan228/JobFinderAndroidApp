<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.fragments.AppliedFragment"
    android:id="@+id/notification_root_lay">

    <LinearLayout
        android:id="@+id/no_notifications_lay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_for_no_saved_lay"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="30dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/no_notifications_iv"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_no_applied"
                android:layout_gravity="center"
                android:padding="20dp"
                android:src="@drawable/icon_notifications_off"
                app:tint="@color/applied_no_icon" />

        </FrameLayout>

        <TextView
            android:id="@+id/no_notifications_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/no_reminders_yet"
            android:textAppearance="@style/TextAppearance.AppCompat.DetFragmentTextAppearanceExtraBold.AppliedFragment"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/no_notifications_tv_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/create_reminders_on_job_detail_pages_to_keep_track_of_important_dates"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/no_notifications_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/light_blue_pr"
            app:rippleColor="@color/light_blue_pr_darker"
            android:text="@string/browse_jobs"
            android:textAppearance="@style/TextAppearance.AppCompat.JobItemTextAppearance"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notifications_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:paddingTop="10dp"
        android:layoutAnimation="@anim/lay_anim_from_left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clipToPadding="false"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>