<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.JobFinderApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/light_blue_pr</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="fontFamily">@font/open_sans</item>
        <item name="colorControlNormal">@color/grey_bot_menu</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="colorSurfaceContainerLow">@color/app_bar_bg</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.JobFinderApp" parent="Base.Theme.JobFinderApp" />

    <style name="TextAppearance.AppCompat.JobItemTextAppearance">
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:letterSpacing">0.015</item>
    </style>
    
    <style name="TextAppearance.AppCompat.JobItemTextAppearance.Dropdown">
        <item name="android:textColor">@color/main_text_color</item>
    </style>


    <style name="TextAppearance.AppCompat.DetFragmentTextAppearanceExtraBold">
        <item name="android:fontFamily">@font/open_sans_extrabold</item>
        <item name="android:textColor">@color/main_text_color</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AppCompat.DetFragmentTextAppearanceExtraBold.AppliedFragment">
        <item name="android:letterSpacing">0.022</item>
    </style>


    
    <style name="TextAppearance.AppCompat.MaToolbarTitle">
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:letterSpacing">0.018</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/main_text_color</item>
    </style>

    <style name="TextAppearance.AppCompat.MaToolbarSubTittle">
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ShapeAppearance.MyRounded"
        parent="ShapeAppearance.MaterialComponents.MediumComponent">

        <item name="boxStrokeColor">@color/grey_stroke_selector</item>
        <item name="cornerSize">16dp</item>

    </style>

    <style name="WhiteDropdown"
        parent="Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox">

        <item name="android:popupBackground">@drawable/bg_dropdown</item>

    </style>

</resources>