<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragments_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.jobfinderapp.views.fragments.HomeFragment"
        android:label="JobSearch"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_detailsFragment"
            app:destination="@id/detailsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_homeFragment_to_filterBottomSheetFragment"
            app:destination="@id/filterBottomSheetFragment"
            app:launchSingleTop="true" />
    </fragment>
    <fragment
        android:id="@+id/savedFragment"
        android:name="com.example.jobfinderapp.views.fragments.SavedFragment"
        android:label="Saved Jobs"
        tools:layout="@layout/fragment_saved" >
        <action
            android:id="@+id/action_savedFragment_to_detailsFragment"
            app:destination="@id/detailsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.jobfinderapp.views.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" >
        <action
            android:id="@+id/action_settingsFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_countrySelectorDialogFragment"
            app:destination="@id/countrySelectorDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.jobfinderapp.views.fragments.DetailsFragment"
        android:label="Job Details"
        tools:layout="@layout/fragment_details">
        <argument
            android:name="jobUIModel"
            app:argType="com.example.jobfinderapp.data.entity.JobUIModel"
            app:nullable="true"
            android:defaultValue="@null"/>
        <deepLink
            android:id="@+id/deepLink"
            app:uri="jobfinder://job/{jobId}" />
        <argument
            android:name="jobId"
            app:argType="string"
            android:defaultValue=""/>
        <action
            android:id="@+id/action_detailsFragment_to_reminderDialogFragment"
            app:destination="@id/reminderDialogFragment"
            app:launchSingleTop="true" />
    </fragment>
    <fragment
        android:id="@+id/appliedFragment"
        android:name="com.example.jobfinderapp.views.fragments.AppliedFragment"
        android:label="Applied Jobs"
        tools:layout="@layout/fragment_applied" >
        <action
            android:id="@+id/action_appliedFragment_to_detailsFragment"
            app:destination="@id/detailsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_appliedFragment_to_withdrawDialogFragment"
            app:destination="@id/withdrawDialogFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>
    <dialog
        android:id="@+id/withdrawDialogFragment"
        android:name="com.example.jobfinderapp.views.fragments.WithdrawDialogFragment"
        android:label="WithdrawDialogFragment" />
    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.jobfinderapp.views.fragments.NotificationsFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_notifications" >
        <action
            android:id="@+id/action_notificationsFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
        <action
            android:id="@+id/action_notificationsFragment_to_reminderDialogFragment"
            app:destination="@id/reminderDialogFragment" />
        <action
            android:id="@+id/action_notificationsFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <dialog
        android:id="@+id/filterBottomSheetFragment"
        android:name="com.example.jobfinderapp.views.fragments.FilterBottomSheet"
        android:label="FilterBottomSheet" />
    <dialog
        android:id="@+id/reminderDialogFragment"
        android:name="com.example.jobfinderapp.views.fragments.ReminderDialogFragment"
        android:label="fragment_reminder_dialog"
        tools:layout="@layout/fragment_reminder_dialog" >
        <argument
            android:name="isEdit"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="reminderId"
            app:argType="long"
            android:defaultValue="0L"/>
        <argument
            android:name="reminderTitle"
            app:argType="string"
            android:defaultValue=""/>
        <argument
            android:name="reminderMessage"
            app:argType="string"
            app:nullable="true"
            android:defaultValue=""/>
        <argument
            android:name="reminderTriggerTime"
            app:argType="long"
            android:defaultValue="0L"/>
    </dialog>
    <dialog
        android:id="@+id/countrySelectorDialogFragment"
        android:name="com.example.jobfinderapp.views.fragments.CountrySelectorDialogFragment"
        android:label="fragment_country_selector_dialog"
        tools:layout="@layout/fragment_country_selector_dialog" >
        <argument
            android:name="selectedCountryCode"
            app:argType="string"
            android:defaultValue="gb"/>
    </dialog>
</navigation>