<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_job_item"
    android:paddingTop="18dp"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="10dp">

    <View
        android:id="@+id/job_name_shimmer"
        android:layout_width="200dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/job_saved_shimmer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/job_company_name_shimmer"
        android:layout_width="140dp"
        android:layout_height="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintStart_toStartOf="@id/job_name_shimmer"
        app:layout_constraintTop_toBottomOf="@id/job_name_shimmer" />

    <View
        android:id="@+id/location_iv_shimmer"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/job_company_name_shimmer" />

    <View
        android:id="@+id/location_address_shimmer"
        android:layout_width="90dp"
        android:layout_height="14dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="@id/location_iv_shimmer"
        app:layout_constraintStart_toEndOf="@id/location_iv_shimmer"
        app:layout_constraintTop_toTopOf="@id/location_iv_shimmer" />

    <View
        android:id="@+id/icon_case_shimmer"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="@id/location_iv_shimmer"
        app:layout_constraintStart_toEndOf="@id/location_address_shimmer"
        app:layout_constraintTop_toTopOf="@id/location_iv_shimmer" />

    <View
        android:id="@+id/contract_time_shimmer"
        android:layout_width="70dp"
        android:layout_height="14dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintBottom_toBottomOf="@id/location_iv_shimmer"
        app:layout_constraintStart_toEndOf="@id/icon_case_shimmer"
        app:layout_constraintTop_toTopOf="@id/location_iv_shimmer" />

    <View
        android:id="@+id/salary_shimmer"
        android:layout_width="80dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/location_iv_shimmer" />

    <View
        android:id="@+id/contract_type_shimmer"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintStart_toEndOf="@id/salary_shimmer"
        app:layout_constraintTop_toTopOf="@id/salary_shimmer" />

    <View
        android:id="@+id/job_description_shimmer_line1"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/salary_shimmer" />

    <View
        android:id="@+id/job_description_shimmer_line2"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/placeholder_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/job_description_shimmer_line1"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>